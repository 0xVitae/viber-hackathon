# Server-side (used by /api/temu-search.ts on Vercel) — NOT exposed to browser
EXA_API_KEY=your_exa_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Client-side (bundled into the JS — exposed to anyone visiting the site)
# Optional: only used by the dev window.exa helper in src/main.tsx
VITE_EXA_API_KEY=your_exa_api_key_here
